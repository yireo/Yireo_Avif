{
    "name": "yireo/magento2-avif",
    "license": "OSL-3.0",
    "version": "0.9.9",
    "type": "magento2-module",
    "homepage": "https://www.yireo.com/software/magento-extensions/avif2",
    "description": "Magento 2 module to add AVIF support to the Magento frontend",
    "keywords": [
        "composer-installer",
        "magento",
        "Magento 2",
        "AVIF",
        "images",
        "Yireo"
    ],
    "require": {
        "ext-gd": "*",
        "ext-pcre": "*",
        "magento/framework": "^101.0.1|^101.1|^102.0|^103.0",
        "magento/module-backend": "^100.0|^101.0|^102.0",
        "magento/module-config": "^101.0.0|^101.1.0",
        "magento/module-store": "^101.0",
        "php": ">=8.2 <8.6",
        "yireo/magento2-next-gen-images": "^0.5.16"
    },
    "require-dev": {
        "bitexpert/phpstan-magento": "^0.42",
        "ext-json": "*",
        "loki/magento2-functional-tests": "@dev",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^9.0|^10.0|^11.0",
        "yireo/magento2-integration-test-helper": "~0.0"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\Avif\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "suggest": {
        "magento/module-swatches": "Update AVIF sources when switching swatches in product listings"
    }
}