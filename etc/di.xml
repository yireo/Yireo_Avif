<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Yireo\NextGenImages\Convertor\ConvertorListing">
        <arguments>
            <argument name="convertors" xsi:type="array">
                <item name="avif" xsi:type="object" sortOrder="-10">Yireo\Avif\Convertor\Convertor</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="Yireo\Avif\VirtualType\Config\Backend\QualityLevel" type="Yireo\Avif\Config\Backend\IntegerRange">
        <arguments>
            <argument name="min" xsi:type="number">0</argument>
            <argument name="max" xsi:type="number">100</argument>
        </arguments>
    </virtualType>

    <virtualType name="Yireo\Avif\VirtualType\Config\Backend\Speed" type="Yireo\Avif\Config\Backend\IntegerRange">
        <arguments>
            <argument name="min" xsi:type="number">0</argument>
            <argument name="max" xsi:type="number">10</argument>
        </arguments>
    </virtualType>

    <virtualType name="Yireo\Avif\VirtualType\Block\Adminhtml\System\Config\ModuleVersion" type="Yireo\NextGenImages\Block\Adminhtml\System\Config\ModuleVersion">
        <arguments>
            <argument name="moduleName" xsi:type="string">Yireo_Avif</argument>
        </arguments>
    </virtualType>
</config>
