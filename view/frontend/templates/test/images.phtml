<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Yireo\Avif\Test\Utils\ImageProvider;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ImageProvider $imageProvider */
$imageProvider = $block->getData('image_provider');
?>
<?php foreach ($imageProvider->getImages() as $image): ?>
    <div>
        <img src="<?= $escaper->escapeUrl($block->getViewFileUrl('Yireo_Avif::' . $image)) ?>"
             alt="<?= $escaper->escapeHtmlAttr(basename($image)) ?>" width="100" height="100"/>
    </div>
<?php endforeach; ?>
